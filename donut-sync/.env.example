# The address members' apps reach this server at. It goes into every invite
# link and every file transfer, so it must work from their computers.
#   In an office network:  http://192.168.1.10:12342  (this machine's address)
#   With the https profile: https://owl.example.com
PUBLIC_URL=http://192.168.1.10:12342

# The name members see for this server in Owl.
WORKSPACE_NAME=Our team

# For `docker compose --profile https up -d`: the domain Caddy gets a
# certificate for. PUBLIC_URL is then https://<DOMAIN>.
# DOMAIN=owl.example.com

# Where shared profiles are kept. `disk` (the default) keeps them in the
# owl-data volume, with nothing else to run. `s3` uses the S3_* settings below.
STORAGE=disk

# --- Only for STORAGE=s3 -----------------------------------------------------
# S3_ENDPOINT=http://localhost:8987
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=owl
# S3_FORCE_PATH_STYLE=true
# The address devices use for transfers when S3_ENDPOINT is only reachable
# from the server (a container name such as http://minio:9000).
# S3_PUBLIC_ENDPOINT=https://storage.example.com

# --- Optional ----------------------------------------------------------------
# A single shared token with the owner's rights, for scripts and older apps.
# Members never need it: they join by invite. At least 24 random characters,
# e.g. `openssl rand -hex 32`.
# SYNC_TOKEN=
